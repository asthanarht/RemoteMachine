<Window x:Class="RemoteHub.Views.VncCredentialsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteMachine - VNC sign-in" Style="{StaticResource {x:Type Window}}" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26">
        <TextBlock x:Name="Heading" Text="Sign in to your Mac" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="Endpoint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,9,0,20"/>
        <StackPanel x:Name="UserFields"><Label Content="_Mac username" Target="{Binding ElementName=User}" Foreground="{DynamicResource Ink}" Padding="0" Margin="0,0,0,8"/><TextBox x:Name="User" MaxLength="63" Margin="0,0,0,16" AutomationProperties.Name="Mac username"/></StackPanel>
        <Label x:Name="PasswordLabel" Content="_Password" Target="{Binding ElementName=Password}" Foreground="{DynamicResource Ink}" Padding="0" Margin="0,0,0,8"/>
        <PasswordBox x:Name="Password" MaxLength="63" MinHeight="40" Padding="11,9" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource FieldBorder}" CaretBrush="{DynamicResource Ink}" AutomationProperties.Name="VNC password"/>
        <TextBlock x:Name="Help" Text="Use your Mac account password. It is used only for this connection and is never saved. Screen and keyboard traffic still require a trusted network or encrypted tunnel." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,16"/>
        <TextBlock x:Name="Error" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,16" AutomationProperties.LiveSetting="Assertive"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="ConnectButton" Content="Connect" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="ConnectClicked"/></StackPanel>
    </StackPanel>
</Window>
