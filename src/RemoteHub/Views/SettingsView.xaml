<UserControl x:Class="RemoteHub.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:RemoteHub.Models">
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,32,36,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Make this workspace yours." Style="{StaticResource MutedText}" Margin="0,0,0,32"/>
            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
            <TextBlock Text="Choose a theme for this app. Changes apply immediately without reconnecting your sessions." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,22"/>
            <Label Content="_App theme" Target="{Binding ElementName=ThemeChoice}" Foreground="{DynamicResource Ink}" Padding="0" Margin="0,0,0,8" FontWeight="SemiBold"/>
            <ComboBox x:Name="ThemeChoice" Width="300" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectionChanged="ThemeChanged" AutomationProperties.Name="App theme">
                <ComboBoxItem Content="Use Windows setting" Tag="{x:Static models:ThemePreference.System}"/>
                <ComboBoxItem Content="Light" Tag="{x:Static models:ThemePreference.Light}"/>
                <ComboBoxItem Content="Dark" Tag="{x:Static models:ThemePreference.Dark}"/>
            </ComboBox>
            <TextBlock x:Name="ThemeStatus" Text="{DynamicResource ThemeDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
            <Border x:Name="SettingsError" Visibility="Collapsed" Background="{DynamicResource DangerSurface}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,0">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            </Border>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,24,0,0" Margin="0,28,0,0">
                <StackPanel>
                    <DockPanel><Border Background="{DynamicResource AccentFill}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0"/><TextBlock Text="Windows accent color" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock Text="Buttons and the fullscreen handle follow your Windows accent. The handle keeps its contrasting outline over remote desktops." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"/>
                    <TextBlock Text="Windows high-contrast themes take priority over this choice. Remote desktop content and Windows credential dialogs keep their own appearance." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,24,0,0" Margin="0,28,0,0">
                <StackPanel>
                    <TextBlock Text="Saved on this PC" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="StorageHelp" Text="Your theme choice is remembered when you reopen the app. Settings are stored separately from your saved connections." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"/>
                    <TextBox x:Name="SettingsPath" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Local settings file path"/>
                    <TextBlock Text="To edit the JSON file manually, close the app first. Theme values are System, Light, and Dark. Reopen the app to load the change." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,24,0,0" Margin="0,28,0,0">
                <DockPanel>
                    <Image x:Name="AboutLogo" Source="{StaticResource AppMark}" Width="72" Height="72" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,24,0" AutomationProperties.Name="RemoteMachine logo"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AboutTitle" Text="About RemoteMachine" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="AboutVersion" Text="Version 0.3.6" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        <TextBlock Text="Your RDP, SSH, and VNC workspace." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
