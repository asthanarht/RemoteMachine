<UserControl x:Class="RemoteHub.Views.AddConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RemoteHub.Controls" xmlns:models="clr-namespace:RemoteHub.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="37,27,37,28">
        <Button Content="←  Back to connections" Style="{StaticResource TextButton}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" Click="CancelClicked" Margin="0,0,0,23"/>
        <TextBlock x:Name="Heading" Text="Make yourself at home." Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Add a computer. Keep it within reach." Style="{StaticResource MutedText}" Margin="0,0,0,28"/>
        <Border x:Name="ImportNotice" Visibility="Collapsed" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,22">
            <StackPanel><TextBlock Text="Review before saving" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock x:Name="ImportMessage" TextWrapping="Wrap" Style="{StaticResource MutedText}" LineHeight="20"/></StackPanel>
        </Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="255"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="How would you like to connect?" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,13"/>
                <UniformGrid Columns="3" Margin="0,0,0,24"><Button x:Name="RdpChoice" Content="RDP" Tag="Rdp" Click="ProtocolClicked" Margin="0,0,9,0" Padding="10,13"/><Button x:Name="SshChoice" Content="SSH" Tag="Ssh" Click="ProtocolClicked" Margin="0,0,9,0"/><Button x:Name="VncChoice" Content="VNC" Tag="Vnc" Click="ProtocolClicked"/></UniformGrid>
                <TextBlock Text="Connection name" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="NameInput" MaxLength="80" Tag="e.g. Design workstation" AutomationProperties.Name="Connection name"/>
                <TextBlock Text="A friendly name that feels familiar." Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,18"/>
                <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Host name or IP address" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="HostInput" MaxLength="253" Tag="Host name or IP address" AutomationProperties.Name="Host name or IP address"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Port" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="PortInput" Text="3389" MaxLength="5" AutomationProperties.Name="Port"/></StackPanel>
                </Grid>
                <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Username (optional)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="UserInput" MaxLength="256" Tag="Ask on connect" AutomationProperties.Name="Username"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Save to group" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="GroupInput" SelectedIndex="0" AutomationProperties.Name="Connection group"><ComboBoxItem Content="Work"/><ComboBoxItem Content="Home"/><ComboBoxItem Content="Cloud"/></ComboBox></StackPanel>
                </Grid>
                <Button x:Name="UseWindowsAccountButton" Content="Use my Windows account" Style="{StaticResource TextButton}" Click="UseWindowsAccountClicked" HorizontalAlignment="Left" Margin="0,-8,0,7"/>
                <TextBlock x:Name="AccountHint" Text="Windows asks for credentials when you connect. Your remote computer may use a different account. No password is stored here." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,18"/>
                <StackPanel x:Name="SshOptions" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="Private key (optional)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseKeyClicked" Margin="8,0,0,0"/><TextBox x:Name="KeyInput" Tag="Use OpenSSH configuration or agent" MaxLength="32767" AutomationProperties.Name="SSH private-key path"/></DockPanel>
                    <TextBlock Text="Only the file path is saved. Enter passwords or key passphrases directly in the terminal. The port above overrides your OpenSSH configuration." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel x:Name="VncOptions" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="Mouse-wheel scroll speed" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="VncScrollSpeedInput" ItemsSource="{x:Static models:ConnectionProfile.VncScrollSpeeds}" ItemTemplate="{StaticResource VncScrollSpeedOption}" SelectedIndex="0" Width="150" HorizontalAlignment="Left" AutomationProperties.Name="VNC scroll speed"/>
                    <TextBlock Text="1× keeps the original distance. Try 3× if each wheel notch moves too little. Saved for this connection; you can adjust it during a session." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,16"/>
                    <CheckBox x:Name="VncViewOnlyInput" Content="View only (disable remote keyboard and pointer)" Margin="0,0,0,14"/>
                    <Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="7" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Use a protected connection" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Standard VNC does not encrypt the screen or keystrokes, even when Mac sign-in protects the password. Never expose port 5900 to the internet. Use a trusted network, VPN, or an existing SSH tunnel." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,12"/>
                            <CheckBox x:Name="VncTrustedInput"><TextBlock Text="I will connect only over a trusted network, VPN, or SSH tunnel." TextWrapping="Wrap"/></CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Expander x:Name="RdpOptions" Header="More options" FontSize="12" Padding="0,10" Margin="0,0,0,15">
                    <StackPanel Margin="0,18,0,0"><TextBlock Text="Domain (optional)" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="DomainInput" MaxLength="256" Tag="Optional domain" AutomationProperties.Name="Domain" Margin="0,0,0,17"/>
                        <CheckBox x:Name="ClipboardInput" Content="Allow clipboard sharing with this computer" Margin="0,0,0,13"/>
                        <CheckBox x:Name="SmartCardsInput" Content="Allow smart cards and Windows Hello for Business" IsChecked="True" Margin="0,0,0,6"/>
                        <TextBlock Text="Required for supported smart-card/Hello sign-in. Makes these authentication devices available to this remote computer; use only with computers you trust." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,13"/>
                        <CheckBox x:Name="SaveCredentialsInput" Content="Allow Windows to save credentials" Margin="0,0,0,13"/>
                        <CheckBox x:Name="LowBandwidthInput" Content="Reduce visual effects on slow connections" Margin="0,0,0,8"/>
                        <TextBlock Text="Native bandwidth detection is always enabled. Drives, printers, and microphone are not redirected." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0"/>
                    </StackPanel>
                </Expander>
                <CheckBox x:Name="FavoriteInput" Content="Add to favorites for one-click access" IsChecked="True" Margin="0,0,0,21"/>
                <Border x:Name="ErrorPanel" Background="{DynamicResource DangerSurface}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,15" Visibility="Collapsed"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Assertive"/></Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelClicked" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="Save connection  →" Style="{StaticResource PrimaryButton}" Click="SaveClicked"/></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Background="{DynamicResource Subtle}" CornerRadius="10" Height="170"><Grid><Border Width="154" Height="100" BorderThickness="5" BorderBrush="White" CornerRadius="7" ClipToBounds="True"><ui:Wallpaper/></Border><Border Background="{DynamicResource AccentFill}" CornerRadius="18" Width="33" Height="33" BorderThickness="3" BorderBrush="{DynamicResource Subtle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,30"><ui:Icon Kind="Check" Stroke="{DynamicResource OnAccent}" Width="17" Height="17"/></Border></Grid></Border>
                <TextBlock Text="A new connection. Less friction." FontSize="16" FontWeight="SemiBold" Margin="0,24,0,9" TextWrapping="Wrap"/>
                <TextBlock Text="Everything you need to get started. Everything else, only when you need it." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="21"/>
                <StackPanel x:Name="RdpHelp">
                <DockPanel Margin="0,26,0,0"><ui:Icon Kind="Monitor" Width="17" Height="17" VerticalAlignment="Top" Margin="0,2,11,0"/><StackPanel><TextBlock Text="Connecting to a Windows PC?" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="The remote computer must support RDP and have Remote Desktop enabled." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"/></StackPanel></DockPanel>
                <DockPanel Margin="0,23,0,0"><ui:Icon Kind="Server" Width="17" Height="17" VerticalAlignment="Top" Margin="0,2,11,0"/><StackPanel><TextBlock Text="Microsoft Dev Box" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Dev Box uses a managed workspace connection. Embedded Dev Box connections are not available in this build; entering its name here does not add workspace support." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"/></StackPanel></DockPanel>
                <DockPanel Margin="0,23,0,0"><ui:Icon Kind="Shield" Width="17" Height="17" VerticalAlignment="Top" Margin="0,2,11,0"/><StackPanel><TextBlock Text="Your credentials stay yours" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Windows handles sign-in and certificate warnings. Authentication security is never bypassed." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"/></StackPanel></DockPanel>
                </StackPanel>
                <StackPanel x:Name="VncHelp" Visibility="Collapsed">
                    <TextBlock Text="Connect to your Mac" FontWeight="SemiBold" Margin="0,26,0,8"/>
                    <TextBlock Text="On the Mac, open System Settings → General → Sharing. Turn on Screen Sharing and allow your Mac user account. Screen Sharing and Remote Management cannot both be enabled." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20"/>
                    <TextBlock Text="Enter the Mac's local hostname or IP and port 5900. RemoteMachine asks for the Mac account password when required; it is not saved. A separate VNC password is also supported when configured on the Mac." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,16,0,0"/>
                    <TextBlock Text="The desktop fits the window without changing the Mac's display resolution. Clipboard sync, file transfer, and automatic SSH tunneling are not included." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,16,0,0"/>
                </StackPanel>
                <StackPanel x:Name="SshHelp" Visibility="Collapsed">
                    <DockPanel Margin="0,26,0,0"><ui:Icon Kind="Terminal" VerticalAlignment="Top" Margin="0,2,11,0"/><StackPanel><TextBlock Text="Your terminal, in this workspace" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Windows OpenSSH runs inside a full terminal. Use passwords, keys, or your configured SSH agent without leaving the app." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/></StackPanel></DockPanel>
                    <DockPanel Margin="0,23,0,0"><ui:Icon Kind="Shield" VerticalAlignment="Top" Margin="0,2,11,0"/><StackPanel><TextBlock Text="Verify the server" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Confirm a new host's fingerprint with its administrator. Changed host keys are not silently trusted." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/></StackPanel></DockPanel>
                    <TextBlock Text="Shell sessions only. File transfer, forwarding, and remote command presets are not included." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,23,0,0"/>
                </StackPanel>
                <DockPanel Margin="0,23,0,0"><ui:Icon Kind="Folder" Width="17" Height="17" VerticalAlignment="Top" Margin="0,2,11,0"/><StackPanel><TextBlock Text="Keep it organized" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Separate work, home, and cloud computers. Your connection library is saved locally." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"/></StackPanel></DockPanel>
            </StackPanel>
        </Grid>
    </StackPanel></ScrollViewer>
</UserControl>
