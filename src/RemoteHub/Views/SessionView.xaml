<UserControl x:Class="RemoteHub.Views.SessionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RemoteHub.Controls" xmlns:models="clr-namespace:RemoteHub.Models">
    <Grid x:Name="LayoutRoot" Margin="28,27,28,23">
        <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="Auto"/><RowDefinition x:Name="ToolbarRow" Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="Auto"/></Grid.RowDefinitions>
        <DockPanel x:Name="HeadingPanel" Margin="0,0,0,23"><Button x:Name="SessionActionButton" DockPanel.Dock="Right" Content="Disconnect" Foreground="{DynamicResource Danger}" BorderBrush="{DynamicResource DangerLine}" Background="{DynamicResource DangerSurface}" VerticalAlignment="Center" Click="DisconnectClicked"/><StackPanel><TextBlock Text="Your workspace, anywhere." FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="Subtitle" Style="{StaticResource MutedText}" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
        <Border x:Name="ToolbarPanel" Grid.Row="1" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="13,9">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel x:Name="VncTools" Orientation="Horizontal" Visibility="Collapsed">
                        <ComboBox x:Name="VncScrollSpeed" Width="112" Margin="0,0,8,0" ItemsSource="{x:Static models:ConnectionProfile.VncScrollSpeeds}" ItemTemplate="{StaticResource VncScrollSpeedOption}" SelectionChanged="VncScrollSpeedChanged" AutomationProperties.Name="VNC scroll speed" ToolTip="Mouse-wheel distance. Applies immediately and is saved for this connection."/>
                        <ComboBox x:Name="MacShortcut" Width="145" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="MacShortcutChanged" AutomationProperties.Name="Mac keyboard shortcuts"><ComboBoxItem Content="Mac shortcuts"/><ComboBoxItem Content="⌘ C · Copy on Mac" Tag="copy"/><ComboBoxItem Content="⌘ V · Paste on Mac" Tag="paste"/><ComboBoxItem Content="⌘ Space · Spotlight" Tag="spotlight"/><ComboBoxItem Content="⌘ Tab · Switch app" Tag="switch"/></ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="SshClipboardTools" Orientation="Horizontal" Visibility="Collapsed"><Button Content="Copy" Click="CopyTerminalClicked" ToolTip="Copy selected terminal text (Ctrl+Shift+C)" Margin="0,0,7,0" Padding="9,7"/><Button Content="Paste" Click="PasteTerminalClicked" ToolTip="Paste into the terminal (Ctrl+Shift+V)" Margin="0,0,7,0" Padding="9,7"/><Button x:Name="SshReconnectButton" Content="Reconnect" Visibility="Collapsed" Click="ReconnectClicked" Margin="0,0,7,0" Padding="9,7"/></StackPanel>
                    <Button Content="Connections" Click="ConnectionsClicked" Margin="0,0,9,0" Padding="11,7" FontSize="11"/>
                    <Button x:Name="FitToWindowButton" Content="Fit to window" Click="FitToWindowClicked" Margin="0,0,9,0" Padding="11,7" FontSize="11"
                            ToolTip="Use all space beside the sidebar without entering fullscreen. VNC keeps its proportions; the session stays connected."/>
                    <Button x:Name="FullScreenButton" Style="{StaticResource PrimaryButton}" Click="FullscreenClicked" Padding="11,7" FontSize="11"><StackPanel Orientation="Horizontal"><ui:Icon Kind="Expand" Width="14" Height="14" Stroke="{DynamicResource OnAccent}" Margin="0,0,7,0"/><TextBlock Text="Focus full screen" Foreground="{DynamicResource OnAccent}"/></StackPanel></Button>
                </WrapPanel>
                <TextBlock x:Name="EndpointText" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>
        <Border x:Name="DesktopFrame" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,1,0" Background="{DynamicResource Subtle}">
            <Grid x:Name="DesktopContainer">
                <ContentControl x:Name="RdpHostSlot"/>
                <Grid x:Name="Placeholder" Background="{DynamicResource Subtle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="25">
                        <ui:Icon Kind="Monitor" Width="42" Height="42" Stroke="{DynamicResource Muted}" Margin="0,0,0,20"/>
                        <TextBlock x:Name="PlaceholderTitle" Text="Ready to connect" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock x:Name="PlaceholderMessage" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource MutedText}" LineHeight="22" Margin="0,12,0,20"/>
                        <Button x:Name="ReconnectButton" Content="Reconnect  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="ReconnectClicked" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="FooterPanel" Grid.Row="3" Background="{DynamicResource StatusSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="0,0,8,8" Padding="12,9">
            <DockPanel><TextBlock x:Name="SessionStatus" Text="Ready" Style="{StaticResource SessionStateText}" FontSize="10"/><TextBlock x:Name="NetworkStatus" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
        </Border>
    </Grid>
</UserControl>
