<UserControl x:Class="RemoteHub.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RemoteHub.Controls">
    <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,32,36,26">
            <DockPanel Margin="0,0,0,25"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Import .rdp" Click="ImportClicked" Margin="0,0,9,0"/><Button Style="{StaticResource PrimaryButton}" Click="NewClicked"><StackPanel Orientation="Horizontal"><ui:Icon Kind="Plus" Stroke="{DynamicResource OnAccent}" Width="15" Height="15" Margin="0,0,8,0"/><TextBlock Text="New connection" Foreground="{DynamicResource OnAccent}"/></StackPanel></Button></StackPanel><StackPanel><TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}"/><TextBlock Text="Your computers. Your work. Right where you left them." Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></DockPanel>
            <Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,28">
                <DockPanel><ui:Icon Kind="Search" Width="16" Height="16" Margin="0,0,9,0"/><Button DockPanel.Dock="Right" Content="Find connection  →" FontSize="11" Padding="10,5" Click="SearchClicked"/><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="5" Tag="Find a computer by name or address" ToolTip="Find a computer by name or address (Ctrl+K)" AutomationProperties.Name="Find a connection" KeyDown="SearchKeyDown"/></DockPanel>
            </Border>
            <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="View all  →" Click="FavoritesClicked"/><TextBlock Text="Your favorites" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
            <Border x:Name="EmptyFavorites" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="26" Margin="0,0,0,15">
                <DockPanel><Border Width="160" Height="115" CornerRadius="8" ClipToBounds="True" Margin="0,0,28,0"><ui:Wallpaper/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Your next connection starts here." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Add a Windows computer and keep it one click away." Style="{StaticResource MutedText}" Margin="0,9,0,17"/><Button Content="Add your first computer  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="NewClicked"/></StackPanel></DockPanel>
            </Border>
            <ItemsControl x:Name="FavoriteCards" ItemsSource="{Binding FavoriteConnections}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,0,15,0" Background="{DynamicResource Surface}" ClipToBounds="True">
                        <StackPanel>
                            <Grid Height="142"><ui:Wallpaper Tone="{Binding Tone}"/><Border Background="{DynamicResource Surface}" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="7,5" Margin="11"><StackPanel Orientation="Horizontal"><ui:Icon Kind="{Binding IconKind}" Width="10" Height="10" Margin="0,0,5,0"/><TextBlock Text="{Binding PlatformLabel}" FontSize="9" Foreground="{DynamicResource Ink}"/></StackPanel></Border><Button Click="FavoriteClicked" Tag="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5" Margin="10" Background="{DynamicResource ImageControl}" BorderThickness="0" ToolTip="Remove from favorites"><ui:Icon Kind="Star" Stroke="{DynamicResource ImageControlInk}" Width="14" Height="14"/></Button><Border VerticalAlignment="Bottom" Height="18" Background="{DynamicResource Subtle}"><TextBlock Text="■  ●  ■  ■" FontSize="9" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                            <StackPanel Margin="15"><DockPanel><ui:Icon Kind="Lock" DockPanel.Dock="Right" Width="13" Height="13"/><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"><Run Text="{Binding Group, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Protocol, Mode=OneWay}"/></TextBlock><DockPanel Margin="0,18,0,0"><Button Content="{Binding ConnectLabel}" Tag="{Binding}" Click="ConnectClicked" DockPanel.Dock="Right" Style="{StaticResource SoftButton}" FontSize="11" Padding="12,6"/><TextBlock Text="{Binding StateText}" Style="{StaticResource SessionStateText}" FontSize="11" VerticalAlignment="Center"/></DockPanel></StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="PreviewNotice" Text="Design-preview profiles only. No sample address is contacted." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,0"/>
            <Grid Margin="0,30,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,28,0"><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="View all  →" Click="AllClicked"/><TextBlock Text="Recent connections" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock x:Name="EmptyRecent" Text="Your connections will appear here after you open an SSH terminal or sign in to a remote desktop." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,18,0,0"/>
                    <DataGrid x:Name="RecentGrid" ItemsSource="{Binding RecentConnections}" MouseDoubleClick="RecentDoubleClick" PreviewKeyDown="RecentKeyDown" Height="285" AutomationProperties.Name="Recent connections">
                        <DataGrid.Columns><DataGridTemplateColumn Header="Connection" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><Border Background="{DynamicResource Subtle}" CornerRadius="7" Width="30" Height="30" Margin="0,0,10,0"><ui:Icon Kind="{Binding IconKind}" Width="16" Height="16"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Endpoint}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="75"/><DataGridTextColumn Header="Last used" Binding="{Binding LastUsedText}" Width="145"/></DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="25,0,0,0"><StackPanel>
                    <TextBlock Text="A place for everything" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,17"/>
                    <Button Style="{StaticResource NavButton}" Tag="Work" Click="GroupClicked" Padding="0,13"><DockPanel><Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Width="34" Height="34" Margin="0,0,12,0"><ui:Icon Kind="Folder"/></Border><StackPanel><TextBlock Text="Work" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkCount, StringFormat='{}{0} connections'}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="Home" Click="GroupClicked" Padding="0,13"><DockPanel><Border Background="{DynamicResource SandSurface}" CornerRadius="7" Width="34" Height="34" Margin="0,0,12,0"><ui:Icon Kind="Folder" Stroke="{DynamicResource SandInk}"/></Border><StackPanel><TextBlock Text="Home" FontWeight="SemiBold"/><TextBlock Text="{Binding HomeCount, StringFormat='{}{0} connections'}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="Cloud" Click="GroupClicked" Padding="0,13"><DockPanel><Border Background="{DynamicResource AvatarSurface}" CornerRadius="7" Width="34" Height="34" Margin="0,0,12,0"><ui:Icon Kind="Server"/></Border><StackPanel><TextBlock Text="Cloud" FontWeight="SemiBold"/><TextBlock Text="{Binding CloudCount, StringFormat='{}{0} connections'}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel></Button>
                    <TextBlock Text="Your credentials stay with Windows. No passwords are stored in the workspace." Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" LineHeight="19" Margin="0,22,0,0"/>
                </StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
