<UserControl x:Class="RemoteHub.Views.ConnectionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:RemoteHub.Controls">
    <Grid Margin="36,32,36,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,23"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Import .rdp" Click="ImportClicked" Margin="0,0,9,0"/><Button Style="{StaticResource PrimaryButton}" Content="+  New connection" Click="NewClicked"/></StackPanel><StackPanel><TextBlock x:Name="Heading" Text="All connections" Style="{StaticResource PageTitle}"/><TextBlock Text="A familiar place for every computer you connect to." Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></DockPanel>
        <StackPanel x:Name="FilterTabs" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15"><Button Content="All devices" Style="{StaticResource FilterButton}" Tag="All" Click="FilterClicked"/><Button Content="Favorites" Style="{StaticResource FilterButton}" Tag="Favorites" Click="FilterClicked"/><Button Content="Work" Style="{StaticResource FilterButton}" Tag="Work" Click="FilterClicked"/><Button Content="Home" Style="{StaticResource FilterButton}" Tag="Home" Click="FilterClicked"/><Button Content="Cloud" Style="{StaticResource FilterButton}" Tag="Cloud" Click="FilterClicked"/></StackPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,17"><ComboBox x:Name="StateFilter" DockPanel.Dock="Right" Width="128" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="StateFilterChanged" AutomationProperties.Name="Filter by session status"><ComboBoxItem Content="Any status"/><ComboBoxItem Content="Active"/><ComboBoxItem Content="Saved"/></ComboBox><TextBox x:Name="SearchBox" TextChanged="SearchChanged" Tag="Search connections by name, address, group, or protocol" ToolTip="Search connections (Ctrl+K)" AutomationProperties.Name="Search connections"/></DockPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,23,0">
                <DataGrid x:Name="ConnectionsGrid" SelectionChanged="SelectionChanged" MouseDoubleClick="DoubleClicked" PreviewKeyDown="ConnectionKeyDown" AutomationProperties.Name="Saved connections">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Connection" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><Border Background="{DynamicResource Subtle}" Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"><ui:Icon Kind="{Binding IconKind}" Width="15" Height="15"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Endpoint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Endpoint}"/></StackPanel></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding Protocol}" Width="55"/><DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="70"/>
                        <DataGridTemplateColumn Header="Status" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StateText}" Style="{StaticResource SessionStateText}" FontSize="11"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="EmptyResults" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"><ui:Icon Kind="Search" Width="32" Height="32" Margin="0,0,0,17"/><TextBlock x:Name="EmptyHeading" Text="No connections found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Try another name, or clear your filters." Style="{StaticResource MutedText}" Margin="0,9,0,17" TextWrapping="Wrap" TextAlignment="Center"/><Button x:Name="ClearFiltersButton" Content="Clear filters" Click="ClearClicked"/><Button x:Name="EmptyAddButton" Content="Add your first computer" Style="{StaticResource PrimaryButton}" Click="NewClicked" Visibility="Collapsed"/></StackPanel>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Border x:Name="Details" Background="{DynamicResource StatusSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Top" ClipToBounds="True">
                <StackPanel>
                    <ui:Wallpaper Tone="{Binding Tone}" Height="147"/>
                    <StackPanel Margin="17,19">
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource SessionStateText}" FontSize="11"/>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,6"/>
                        <TextBlock Text="{Binding ConnectionDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,18" TextWrapping="Wrap"/>
                        <Button Content="{Binding ConnectLabel}" Style="{StaticResource PrimaryButton}" Click="ConnectClicked"/>
                        <Grid Margin="0,21,0,19">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Address" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Host}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Right" Margin="0,0,0,13"/>
                            <TextBlock Grid.Row="1" Text="Port" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Port}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Text="Group" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Group}" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="3" Text="Account" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UserNameDisplay}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Right"/>
                        </Grid>
                        <Button x:Name="FavoriteButton" Content="Add to favorites" Click="FavoriteClicked" Margin="0,0,0,9"/>
                        <Button Content="Edit connection" Click="EditClicked" Margin="0,0,0,9"/>
                        <Button x:Name="ExportButton" Content="Export .rdp" Click="ExportClicked" Margin="0,0,0,9" ToolTip="Export a standard RDP profile without credentials. SSH and VNC profiles cannot be exported as .rdp files."/>
                        <Button Content="Remove connection" Click="DeleteClicked" Style="{StaticResource TextButton}" Foreground="{DynamicResource Danger}" FontSize="11"/>
                        <TextBlock Text="{Binding CredentialDescription}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11" LineHeight="18" Margin="0,17,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border></ScrollViewer>
        </Grid>
        <TextBlock x:Name="ResultCount" Grid.Row="4" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>
    </Grid>
</UserControl>
